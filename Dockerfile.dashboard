# Nurse dashboard image (FastAPI + Uvicorn). Used by docker-compose.yml.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY src/nurse_dashboard ./src/nurse_dashboard

# Run as a non-root user.
RUN useradd --create-home --uid 1000 dashboard && mkdir -p /app/data/dashboard && chown -R dashboard /app/data
USER dashboard

EXPOSE 8000
CMD ["uvicorn", "nurse_dashboard.app:app", "--host", "0.0.0.0", "--port", "8000"]
